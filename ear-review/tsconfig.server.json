{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "dist/server",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/**/*.ts",
    "scripts/train.ts",
    "scripts/evaluate.ts",
    "scripts/compare-models.ts",
    "scripts/verify-semantic-web.ts",
    "scripts/import-real-csv.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
