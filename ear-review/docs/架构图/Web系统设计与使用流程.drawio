  <diagram id="runtime" name="02 Web 内部处理与分层" dataPageMeta="%7B%22title%22%3A%2202%20Web%20%E5%86%85%E9%83%A8%E5%A4%84%E7%90%86%E4%B8%8E%E5%88%86%E5%B1%82%22%2C%22theme%22%3A%22tech-blue%22%2C%22profile%22%3A%22engineering-review%22%2C%22layout%22%3A%22horizontal%22%2C%22canvas%22%3A%221590x1480%22%2C%22font%22%3A%7B%22primary%22%3A%22Microsoft%20YaHei%22%2C%22cjk%22%3A%22Microsoft%20YaHei%22%2C%22formula%22%3A%22Microsoft%20YaHei%22%7D%7D">
