  <diagram id="usage" name="01 用户使用与数据流" dataPageMeta="%7B%22title%22%3A%2201%20%E7%94%A8%E6%88%B7%E4%BD%BF%E7%94%A8%E4%B8%8E%E6%95%B0%E6%8D%AE%E6%B5%81%22%2C%22theme%22%3A%22tech-blue%22%2C%22profile%22%3A%22engineering-review%22%2C%22layout%22%3A%22horizontal%22%2C%22canvas%22%3A%221860x890%22%2C%22font%22%3A%7B%22primary%22%3A%22Microsoft%20YaHei%22%2C%22cjk%22%3A%22Microsoft%20YaHei%22%2C%22formula%22%3A%22Microsoft%20YaHei%22%7D%7D">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1904" pageHeight="904" math="1" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" dataPageId="usage" dataObjectId="title" dataObjectKind="node" id="2"><mxCell value="听见｜从耳机评论到产品评价" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=26;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="32" y="16" width="1790" height="48" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="subtitle" dataObjectKind="node" id="3"><mxCell value="实线表示主要操作顺序；采集结果仍需预览并确认导入，不会直接进入统计。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=15;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="32" y="72" width="1790" height="50" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="select" dataObjectKind="node" id="4"><mxCell value="1 确定分析对象&lt;br&gt;创建或选择具体耳机&lt;br&gt;确认商品编号与评论归属" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#edf4f0;strokeColor=#668572;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="340" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="get" dataObjectKind="node" id="5"><mxCell value="2 获取评论 CSV&lt;br&gt;上传已有 CSV&lt;br&gt;或从平台采集后生成 CSV" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fillColor=#faf5e8;strokeColor=#a68b55;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="334" y="340" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="preview" dataObjectKind="node" id="6"><mxCell value="3 映射与预览&lt;br&gt;选择正文列、编码及产品&lt;br&gt;校验空值、长度和重复" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#edf4f0;strokeColor=#668572;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="636" y="340" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="commit" dataObjectKind="node" id="7"><mxCell value="4 确认导入&lt;br&gt;保存有效非重复评论&lt;br&gt;形成独立数据批次" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#edf4f0;strokeColor=#668572;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="938" y="340" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="analyze" dataObjectKind="node" id="8"><mxCell value="5 批量 NLP 分析&lt;br&gt;选择本地模型或基线&lt;br&gt;逐条处理并保存状态" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#edf4f0;strokeColor=#668572;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="340" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="show" dataObjectKind="node" id="9"><mxCell value="6 查看分析结果&lt;br&gt;环形图、六方面分布&lt;br&gt;产品画像与产品对比" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#edf4f0;strokeColor=#668572;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1542" y="340" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="csv-own" dataObjectKind="node" id="10"><mxCell value="已有 CSV&lt;br&gt;真实评论正文 + 数据来源&lt;br&gt;不要求情感训练标签" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fillColor=#faf5e8;strokeColor=#a68b55;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="334" y="152" width="250" height="112" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="platform" dataObjectKind="node" id="11"><mxCell value="平台采集入口&lt;br&gt;搜索耳机 → 粘贴详情链接&lt;br&gt;Chrome 辅助自动读取" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#edf3fa;strokeColor=#6783a1;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="552" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="collection" dataObjectKind="node" id="12"><mxCell value="正常登录后自动打开全部评价&lt;br&gt;自动滚动 / 翻页 / 去重&lt;br&gt;最多 100 条；不足则部分采集" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#edf3fa;strokeColor=#6783a1;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="334" y="552" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="invalid" dataObjectKind="node" id="13"><mxCell value="校验错误或重复&lt;br&gt;展示原因并修改 CSV / 映射&lt;br&gt;重复数据不重复计入" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff7f2;strokeColor=#b48a74;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="636" y="552" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="persist" dataObjectKind="node" id="14"><mxCell value="SQLite：batches / reviews&lt;br&gt;保留来源与合成数据标记&lt;br&gt;CSV 导入不等于模型训练" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#f1eef8;strokeColor=#8a78a3;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="938" y="552" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="failure" dataObjectKind="node" id="15"><mxCell value="任务进度 / 失败原因&lt;br&gt;成功结果保留；失败可重试&lt;br&gt;历史任务可查询" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff7f2;strokeColor=#b48a74;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="552" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="trace" dataObjectKind="node" id="16"><mxCell value="打开原文与证据&lt;br&gt;人工复核并保留历史&lt;br&gt;导出分析 CSV" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#edf4f0;strokeColor=#668572;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1542" y="552" width="250" height="136" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="limits" dataObjectKind="node" id="17"><mxCell value="边界：平台验证仍由用户正常完成；自动采集不保证获得全部买家评论。图表反映评论中的方面评价，并非耳机性能实测。" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=15;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="32" y="760" width="1750" height="60" as="geometry" /></mxCell></UserObject><UserObject label="" dataPageId="usage" dataObjectId="e-select-get" dataObjectKind="edge" id="18"><mxCell value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=