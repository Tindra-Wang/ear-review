          <mxGeometry height="124" width="480" x="100" y="740" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.5;fontColor=#111111;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" value="字符 n-gram + MNB 对数评分&lt;br&gt;方面 ID 作为特征输入&lt;br&gt;规则处理部分否定 / 转折表达" vertex="1">
