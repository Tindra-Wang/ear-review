  <diagram id="training" name="02 双模型准备与训练" dataPageMeta="%7B%22title%22%3A%2201%20%E6%96%B9%E5%90%91%E4%B8%8E%E5%8F%8C%E6%A8%A1%E5%9E%8B%E5%87%86%E5%A4%87%22%2C%22theme%22%3A%22tech-blue%22%2C%22profile%22%3A%22engineering-review%22%2C%22layout%22%3A%22horizontal%22%2C%22canvas%22%3A%221320x1530%22%2C%22font%22%3A%7B%22primary%22%3A%22Microsoft%20YaHei%22%2C%22cjk%22%3A%22Microsoft%20YaHei%22%2C%22formula%22%3A%22Microsoft%20YaHei%22%7D%7D">
