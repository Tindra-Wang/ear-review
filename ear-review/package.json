{
  "name": "ear-review", "private": true, "version": "1.0.0", "type": "module",
  "engines": { "node": ">=24.14.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.web.json",
    "start": "node dist/server/apps/api/src/main.js",
    "test": "vitest run --config vitest.config.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "train": "tsx scripts/train.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6", "@nestjs/core": "^11.1.6", "@nestjs/platform-express": "^11.1.6",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "vue": "^3.5.22", "vue-router": "^4.5.1",
    "lucide-vue-next": "^0.468.0", "csv-parse": "^6.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3", "@types/node": "^24.5.2", "@vitejs/plugin-vue": "^6.0.1",
    "@playwright/test": "^1.55.1", "concurrently": "^9.2.1", "tsx": "^4.20.6", "typescript": "~5.9.3",
    "vite": "^7.1.9", "vitest": "^3.2.4", "vue-tsc": "^3.1.0"
  }
}
